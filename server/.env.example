# Server environment variables
# Copy this file to ".env" and fill in real values. Never commit ".env".

# Server
PORT=4000
NODE_ENV=development

# Database (Prisma + PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://clinicappointment:12345678@localhost:5432/clinicAppointment?schema=public"

# Auth
# Generate a strong random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="Superexcited"
JWT_EXPIRES_IN=7d
